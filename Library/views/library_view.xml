<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- action Library -->
    <record id="action_library_view" model="ir.actions.act_window">
        <field name="name">Library view</field>
        <field name="res_model">library.library</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--form view of Library -->
    <record id="action_library_form" model="ir.ui.view">
        <field name="name">Book Form</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="capacity"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="isbn"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- tree view of library -->
    <record id="view_library_list" model="ir.ui.view">
        <field name="name">Library.list</field>
        <field name="model">library.library</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>
</odoo>

