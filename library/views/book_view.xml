<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- action book -->
    <record id="action_book_view" model="ir.actions.act_window">
        <field name="name">books View</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- form view of book -->
    <record id="view_book_form_view" model="ir.ui.view">
        <field name="name">Book Form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="author"/>
                        <field name="isbn"/>
                        <field name="library_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List view of book -->
    <record id="view_book_list_view" model="ir.ui.view">
        <field name="name">book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="library_id"/>
            </list>
        </field>
    </record>
</odoo>

