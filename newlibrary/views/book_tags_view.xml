<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- This record shall be stored in the specified model and view using act_window. -->
    <record id="action_booktags_view" model="ir.actions.act_window">
        <field name="name">Booktags View</field>
        <field name="res_model">newlibrary.book.tags</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- This shall display booktag as a form -->
    <record id="view_booktags_form_view" model="ir.ui.view">
        <field name="name">booktags.form</field>
        <field name="model">newlibrary.book.tags</field>
        <field name="arch" type="xml">
            <form string="Book Tags">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- This shall display booktag as a list -->
    <record id="view_booktags_list_view" model="ir.ui.view">
        <field name="name">booktags.list</field>
        <field name="model">newlibrary.book.tags</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>