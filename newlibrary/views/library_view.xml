<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- This record shall be stored in the specified model and view using act_window. -->
    <record id="action_library_view" model="ir.actions.act_window">
        <field name="name">Libraries</field>
        <field name="res_model">newlibrary.library</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- This shall display library as a list -->
    <record id="view_library_list" model="ir.ui.view">
        <field name="name">newlibrary.library.list</field>
        <field name="model">newlibrary.library</field>
        <field name="arch" type="xml">
            <list string="Libraries">
                <field name="name"/>
                <field name="location"/>
                <field name="capacity"/>
            </list>
        </field>
    </record>

    <!-- This shall display library as a form -->
    <record id="view_library_form" model="ir.ui.view">
        <field name="name">newlibrary.library.form</field>
        <field name="model">newlibrary.library</field>
        <field name="arch" type="xml">
            <form string="Library">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="capacity"/>
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="author"/>
                                    <field name="isbn"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>